{
  "id": "opss.soundpad",
  "name": "Soundpad",
  "version": "1.0.0",
  "description": "Phone-controlled soundpad: play WAV sounds from the plugin's sounds/ directory, mixed into the MicYou mic stream. Multi-voice, with per-session volume / seek / loop driven from the MicYou Android app.",
  "descriptionI18n": {
    "zh": "手机遥控音效板：播放插件 sounds/ 目录中的 WAV 音效并混入 MicYou 麦克风流。支持多音效同时播放，安卓端可控制每条播放的进度、音量与循环。",
    "zh-CN": "手机遥控音效板：播放插件 sounds/ 目录中的 WAV 音效并混入 MicYou 麦克风流。支持多音效同时播放，安卓端可控制每条播放的进度、音量与循环。"
  },
  "nameI18n": {
    "zh": "音效板",
    "zh-CN": "音效板",
    "en": "Soundpad"
  },
  "author": "OrientCOMPASS",
  "license": "Unlicense",
  "runtime": "native",
  "entry": "soundpad",
  "platforms": [
    "windows",
    "linux",
    "macos"
  ],
  "arches": [
    "x86_64",
    "aarch64"
  ],
  "apiVersion": 1,
  "capabilities": [
    "dsp.node",
    "config.read",
    "config.write",
    "message.send",
    "device.list"
  ],
  "kind": "dsp",
  "dsp": {
    "insertAfter": "VAD",
    "realtimeSafe": true
  },
  "ui": {
    "route": "panel",
    "label": "Soundpad",
    "panels": [
      {
        "id": "console",
        "label": "Soundpad",
        "entry": "panel.html"
      }
    ]
  },
  "keywords": [
    "soundpad",
    "sounds",
    "mix",
    "dsp",
    "remote",
    "android"
  ],
  "config": {
    "masterVolume": 1.0,
    "sounds": [],
    "sp_state": {
      "sessions": [],
      "sounds": [],
      "lastError": "",
      "masterVolume": 1.0
    }
  },
  "configSchema": {
    "fields": [
      {
        "key": "masterVolume",
        "fieldType": "number",
        "label": "主音量 Master Volume",
        "description": "所有音效混入麦克风时的总增益（0.0 - 2.0，1.0 = 原始音量）。",
        "min": 0,
        "max": 2,
        "step": 0.05,
        "default": 1.0
      }
    ]
  },
  "repository": "https://github.com/OrientCOMPASS/MicYouSoundpad-plugin",
  "homepage": "https://github.com/OrientCOMPASS/MicYouSoundpad-plugin",
  "updateUrl": "https://github.com/OrientCOMPASS/MicYouSoundpad-plugin/releases/latest/download/plugin.json",
  "downloadUrl": "https://github.com/OrientCOMPASS/MicYouSoundpad-plugin/releases/latest/download/plugin.zip",
  "readmeUrl": "https://raw.githubusercontent.com/OrientCOMPASS/MicYouSoundpad-plugin/refs/heads/main/README.md"
}
